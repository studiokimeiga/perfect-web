# The VM's TLS front (track `deploy`, ADR-XXXX, a production host): Caddy's
# automatic HTTPS for the deployment's domain (a certificate from Let's
# Encrypt, renewed by Caddy), HTTP/2 and HTTP/3 to browsers, and the host
# behind it on the loopback. deploy/vm/setup.sh writes it to
# /etc/caddy/Caddyfile, PLERIS_DOMAIN replaced by the domain.
#
# The host sends HSTS, nosniff and each page's policy itself, so they are
# the same behind any front.

{
	# No admin API (the review's finding 5j): its endpoint, on the
	# loopback's port 2019 by default, takes a new configuration from any
	# process on the VM. Without it a change of configuration is a restart
	# (`systemctl restart caddy`, as setup.sh does), never `caddy reload`.
	admin off
	# What a reader looked up is kept by no log (the review's finding 5e):
	# Caddy's own lines (an error a request met names the request) drop its
	# path and query and the page it came from, as the access log below
	# does. Cookie, Authorization and their like Caddy itself writes as
	# REDACTED.
	log default {
		format filter {
			wrap json
			request>uri delete
			request>headers>Referer delete
		}
	}
}

PLERIS_DOMAIN {
	# No `encode`: the host compresses its build's assets itself, and never
	# a session's answer, which holds its reader's data beside what its
	# address reflects (BREACH). `encode` would compress both.
	reverse_proxy 127.0.0.1:8080 {
		# A request that comes while the host restarts waits for it, up to
		# ten seconds, rather than failing.
		lb_try_duration 10s
		lb_try_interval 250ms
	}
	header -Server
	log {
		output file /var/log/caddy/pleris-access.log {
			roll_size 50MiB
			roll_keep 10
		}
		# Each request's method, host, status, size and time, never its
		# path, its query (`/word/<word>`, `?q=<what was searched>`) or the
		# page it came from: the host's own line says each request by its
		# route's pattern (`/word/{word}`).
		format filter {
			wrap json
			request>uri delete
			request>headers>Referer delete
		}
	}
}
