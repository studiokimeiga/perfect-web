# A Pleris program's production host on one VM (track `deploy`, ADR-XXXX, a
# production host). deploy/vm/setup.sh installs this as
# /etc/systemd/system/pleris.service; deploy/vm/release.sh puts each release
# in /opt/pleris/releases/<commit> and points /opt/pleris/current at it.
#
# Its settings are /etc/pleris/pleris.env, nothing secret. Its secrets are
# /etc/pleris/secrets, root's and mode 600, which systemd hands the service as
# a credential it alone reads (systemd.exec(5): environment variables "are
# not suitable for passing secrets"; use LoadCredential=). Caddy, in front,
# holds TLS (deploy/vm/Caddyfile); the host listens on the loopback alone.

[Unit]
Description=Pleris production host
Documentation=https://github.com/studiokimeiga/perfect-web/tree/master/deploy
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=simple
User=pleris
Group=pleris
EnvironmentFile=/etc/pleris/pleris.env
Environment=PW_DEPLOYMENT=production
# The host reads the credential named `secrets` from $CREDENTIALS_DIRECTORY,
# which systemd sets; no `%d` specifier (systemd 249 does not resolve it in
# Environment=).
LoadCredential=secrets:/etc/pleris/secrets
ExecStart=/opt/pleris/current/pleris-host /opt/pleris/current/dist
# SIGTERM: no new connection, the open ones finished within the host's
# grace (PW_SHUTDOWN_GRACE, 8 s), then it ends with 0.
KillSignal=SIGTERM
TimeoutStopSec=20
Restart=on-failure
RestartSec=2
# What it may write, its own: /var/lib/pleris (an upload's blobs) and
# /var/cache/pleris (kiokun's search index).
StateDirectory=pleris
CacheDirectory=pleris
UMask=0077
# What it may hold (the review's finding 1d). The host takes at most
# PW_MAX_CONNECTIONS connections (1,024 where pleris.env says nothing), a
# thread each, and answers one more 503 itself; its own threads besides
# (the stop's, the clock's, the scheduler's, a readiness check's, a commit's
# tellers, Wasmtime's compiler at start) are a few dozen. TasksMax= holds
# the process to four times its connections: past it a connection's thread
# is refused, which the host drops and lives through. Three descriptors a
# connection: LimitNOFILE= is well past 3,328. Its memory, measured with
# the release build (deploy/host-memory.sh, which just e14-deploy runs):
# kiokun's host peaks at 1,037 to 1,140 MiB as it starts on the
# repository's sample, on one, two or 32 CPUs, most of it Cranelift
# compiling the `kiokun.site.Word` component (247 MiB without it), and
# holds 655 to 1,139 MiB after; on kiokun.com's own data, 1,046 to 1,223 MiB
# on two CPUs (1,649 MiB once, on 32 CPUs of a loaded machine). The store's
# host, 225 MiB (a debug build's). MemoryHigh= is above that peak, so a start is not
# throttled (no swap gives back what the compiler holds), and throttles and
# reclaims past it (kiokun's dictionary is read through the page cache,
# charged here and given back); MemoryMax= ends the process, which
# Restart= starts again. Each a share of the VM, so each grows with it: a
# VM of 2 GiB, the smallest that runs kiokun, gives 1,536 and 1,741 MiB,
# and leaves Caddy, sshd and the system 307 MiB (kiokun needs no
# PostgreSQL; the store's host is a fifth of kiokun's).
TasksMax=4096
MemoryHigh=75%
MemoryMax=85%
LimitNOFILE=65536

# Its confinement (systemd.exec(5)); `systemd-analyze security pleris`
# scores it. Not MemoryDenyWriteExecute=: Wasmtime compiles the program's
# components to machine code at start (Cranelift), which needs memory it
# writes and then runs. No system call filter: none is measured against
# Wasmtime here yet (the ADR's next step).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
