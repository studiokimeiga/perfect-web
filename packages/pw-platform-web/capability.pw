// @corpus: platform
// @id: PLATFORM-capability
// @category: platform — capability handles
// @charter: §7.8, §11
// @milestone: E2C

module capability

// A capability's secret material. The privacy checker reads `Secret<C>` as a
// restriction that never leaves the origin; the placement solver reads the
// capability family from the effect row of whatever produced it. One
// declaration, three consumers — which is the point of E2C.
opaque type Secret<C> = String

// The privacy LEVELS, as declared types. A sink's level is written as a type
// argument in its effect row — `log<Public>` — so `Public` has to be something
// a signature can name. A checker that recognised the string "Public" would be
// inventing the vocabulary it then enforces.
type Public = Public {}

type Private = Private {}

// The capability tags a `Secret<C>` can carry. Declared, so a privacy label
// naming one is checkable rather than a string a checker invented.
type Payments = Payments { name: String }

type Signing = Signing { name: String }

// The scoping labels, as declared types. `Session<SessionId>` is a type a
// signature can return, which is what lets the privacy checker read a label
// instead of inferring one from a function's name.
opaque type Session<S> = String

opaque type User<U> = String

opaque type Organization<O> = String

opaque type SessionId = String

opaque type UserId = String

opaque type OrganizationId = String

// **The id of the user a handle is** (ADR-0384 H1). An owned table's row
// names its owner by id, so a program writing its reader's row needs that id
// as a value; until now it read it only through Rust. An id grants nothing
// (ADR-0270): every read and write of an owned table takes the handle, which
// only the platform makes (ADR-0263), and never an id in its place. What is
// made from the handle is its user's, as every call's result carries its
// argument's label (ADR-0129).
fn id_of(user: User<UserId>) -> UserId !{} {
    UserId(user.value)
}
