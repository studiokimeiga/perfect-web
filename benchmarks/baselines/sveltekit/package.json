{
  "name": "pw-bench-sveltekit",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "start": "node build",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "6.0.0",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.3"
  },
  "pnpm": {
    "overrides": {
      "cookie@<0.7.0": "0.7.2",
      "deepmerge": "file:vendor/deepmerge"
    }
  },
  "packageManager": "pnpm@10.15.1"
}
