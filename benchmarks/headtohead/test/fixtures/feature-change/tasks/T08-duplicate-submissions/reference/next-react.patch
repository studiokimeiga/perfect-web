+// Each session's recent interactions, so a press whose request arrives twice
+// is applied once. Bounded: the last 64 per session.
+const seen: Map<string, string[]> =
+  ((globalThis as Record<string, unknown>).__pwBenchSeen as Map<string, string[]>) ?? new Map();
+(globalThis as Record<string, unknown>).__pwBenchSeen = seen;
+
+/** True the first time a session presents an interaction, false after. */
+export function firstTime(session: string, interaction: string): boolean {
+  const mine = seen.get(session) ?? [];
+  if (mine.includes(interaction)) return false;
+  mine.push(interaction);
+  if (mine.length > 64) mine.shift();
+  seen.set(session, mine);
+  return true;
+}
