@@ -0,0 +1,20 @@
+"use client";
+
+import { addToCartAction } from "./actions";
+
+// One interaction per press, made when the press happens: a retried request
+// carries the same one, and the server applies it once.
+export function AddForm({ store, item }: { store: string; item: string }) {
+  return (
+    <form
+      action={async (formData) => {
+        formData.set("interaction", crypto.randomUUID());
+        await addToCartAction(formData);
+      }}
+    >
+      <input type="hidden" name="store" value={store} />
+      <input type="hidden" name="item" value={item} />
+      <button type="submit">Add</button>
+    </form>
+  );
+}
