@@ -0,0 +1,50 @@
+"use client";
+
+import { useOptimistic } from "react";
+import { addToCartAction, clearCartAction } from "./actions";
+
+type Item = { id: string; name: string };
+
+// The menu and the cart, with the count shown optimistically: it moves when
+// Add is pressed, and React puts it back if the action fails.
+export function StoreView({ storeId, menu, count }: { storeId: string; menu: Item[]; count: number }) {
+  const [shown, addShown] = useOptimistic(count, (current: number, added: number) => current + added);
+  return (
+    <>
+      <section aria-label="Menu">
+        <ul id="menu">
+          {menu.map((item) => (
+            <li key={item.id}>
+              <span>{item.name}</span>
+              <form
+                action={async (formData) => {
+                  addShown(1);
+                  try {
+                    await addToCartAction(formData);
+                  } catch {
+                    // Refused or failed: the optimistic count is discarded
+                    // when this action ends, and the server's stands.
+                  }
+                }}
+              >
+                <input type="hidden" name="store" value={storeId} />
+                <input type="hidden" name="item" value={item.id} />
+                <button type="submit">Add</button>
+              </form>
+            </li>
+          ))}
+        </ul>
+      </section>
+
+      <section aria-label="Cart">
+        <p id="cart-count">{shown}</p>
+        <form action={clearCartAction}>
+          <input type="hidden" name="store" value={storeId} />
+          <button id="clear-cart" type="submit">
+            Clear
+          </button>
+        </form>
+      </section>
+    </>
+  );
+}
