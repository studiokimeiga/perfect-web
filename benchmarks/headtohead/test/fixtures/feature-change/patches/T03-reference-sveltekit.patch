+export type CartEntry = { itemId: MenuItemId; name: string; quantity: number };
+
+/** The cart's lines, each with its item's name: what the cart section lists. */
+export function cartLines(store: StoreId, session: string | undefined): CartEntry[] {
+  const menu = MENUS[store] ?? [];
+  return getCart(session).lines.map((line) => ({
+    itemId: line.itemId,
+    name: menu.find((m) => m.id === line.itemId)?.name ?? line.itemId,
+    quantity: line.quantity,
+  }));
+}
+
 /** How many items the cart holds: what the page shows. */
 export function lineCount(cart: Cart): number {
   return cart.lines.reduce((n, line) => n + line.quantity, 0);
