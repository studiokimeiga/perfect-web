+import { NextResponse, type NextRequest } from "next/server";
+import { setSlowCategory } from "@/lib/store";
+
+/** Make one of the menu's categories slow to read: `?slow=hot&delay=1500`.
+ * A benchmark's hook, as every stack in it has one. */
+export async function POST(request: NextRequest) {
+  const params = request.nextUrl.searchParams;
+  setSlowCategory(params.get("slow"), Number(params.get("delay") ?? 0));
+  return NextResponse.json({});
+}
