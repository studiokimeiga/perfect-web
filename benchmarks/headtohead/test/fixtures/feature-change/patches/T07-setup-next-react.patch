+"use client";
+
+import { useEffect, useState } from "react";
+
+type Item = { id: string; name: string };
+
+const CATEGORIES = [
+  ["all", "All"],
+  ["hot", "Hot"],
+  ["cold", "Cold"],
+] as const;
+
+/** The menu by category: the chosen category's items, read again when it
+ * changes. */
+export function Browse({ storeId, initial }: { storeId: string; initial: Item[] }) {
+  const [category, setCategory] = useState<string>("all");
+  const [items, setItems] = useState<Item[]>(initial);
+  useEffect(() => {
+    fetch(`/api/menu?store=${storeId}&category=${category}`)
+      .then((r) => r.json())
+      .then((found: Item[]) => setItems(found));
+  }, [storeId, category]);
+
+  return (
+    <section aria-label="Browse">
+      <nav aria-label="Categories">
+        {CATEGORIES.map(([id, label]) => (
+          <button key={id} type="button" onClick={() => setCategory(id)}>
+            {label}
+          </button>
+        ))}
+      </nav>
+      <ul id="browse">
+        {items.map((item) => (
+          <li key={item.id}>{item.name}</li>
+        ))}
+      </ul>
+    </section>
+  );
+}
