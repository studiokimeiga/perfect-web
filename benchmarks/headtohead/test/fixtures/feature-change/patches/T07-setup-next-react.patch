+import { NextResponse, type NextRequest } from "next/server";
+import { menuIn, slowFor } from "@/lib/store";
+
+export const dynamic = "force-dynamic";
+
+/** The store's menu items in a category: `?store=..&category=..`. Reading a
+ * category takes as long as it takes. */
+export async function GET(request: NextRequest) {
+  const params = request.nextUrl.searchParams;
+  const category = params.get("category") ?? "all";
+  await new Promise((resolve) => setTimeout(resolve, slowFor(category)));
+  return NextResponse.json(menuIn(params.get("store") ?? "", category));
+}
