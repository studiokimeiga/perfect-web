@@ -99,6 +100,40 @@ session query Cart(session: Session<SessionId>) -> Result<Cart, CartError>
 // The mutation. Idempotent by interaction id: a request sent twice is one add,
 // and two presses are two. Optimistic, with a declared rollback, so the count
 // moves before the round trip and moves back if it fails.
+// What the cart section lists of each line: its item's name, and how many.
+type CartEntry = CartEntry {
+    item_id: MenuItemId,
+    name: String,
+    quantity: Int,
+}
+
+// The name a menu gives an item.
+fn name_in(menu: List<MenuItem>, item: MenuItemId) -> String !{} {
+    List.fold(menu, "", fn(found, entry) if same_item(entry.id, item) { entry.name } else { found })
+}
+
+session query CartLines(id: StoreId, session: Session<SessionId>) -> Result<List<CartEntry>, CartError>
+    freshness      0.seconds
+    consistency    read_your_writes
+    cache          private
+    key            id, session
+    invalidates_on CartChanged(session)
+    concurrency    one_per_key
+    on_key_change  cancel
+    timeout        2.seconds
+{
+    let cart = Carts.current(session)?
+    let menu = match Menus.for_store(id) {
+        Ok(items) => items,
+        Err(_) => [],
+    }
+    Ok(List.map(cart.lines, fn(line) CartEntry {
+        item_id: line.item_id,
+        name: name_in(menu, line.item_id),
+        quantity: line.quantity.count,
+    }))
+}
+
