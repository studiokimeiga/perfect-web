# Build outputs
/target/
**/target/
dist/
build/
# the koka spike writes build-negA/ and build-negB/ for its negative cases
# (a trailing comment on the same line as a pattern does NOT work in .gitignore)
build-*/
# dune (spikes/bonsai-incremental-model)
_build/
# headless-chrome profile created by spikes/layout-phase-scheduler
.chrome-profile/
.output/
*.wasm.map

# Toolchain artifacts fetched by `just bootstrap` (pinned in tools/versions.lock)
/.toolchain/

# Node
node_modules/
.pnpm-store/
*.tsbuildinfo
# Framework build output (benchmarks/baselines, E14)
.next/
.svelte-kit/
next-env.d.ts

# Generated intermediate sources (never authoring source of truth)
/generated/
**/.pw-build/

# Local environment
.env
.env.local
.DS_Store

# Test / benchmark scratch
/benchmarks/results/
/benchmarks/harness/.grading/
playwright-report/
test-results/
# A failing browser run's output, kept where the next run does not clear it
# (scripts/keep_traces.py)
kept-traces/
blob-report/

# Local CA material — never commit (PROJECT_CHARTER.md §3.7, §14 M11)
lab/certs/*.pem
lab/certs/*.key
lab/certs/rootCA*

# Editor
.idea/
.vscode/*
!.vscode/extensions.json
# headless-chrome profile created by spikes/browser-resumption
spikes/browser-resumption/.chrome-profile/

# `-C instrument-coverage` writes these next to the process that ran. The
# fuzzer cleans its own, but a harness killed mid-run leaves them here.
*.profraw
*.profdata

# Python bytecode from the scripts/ test suites.
__pycache__/

# Wrangler's local cache records the Cloudflare account it deployed with
# (pleris.dev, 2026-11-06): never in the repository.
.wrangler/
