{
  "schema": 1,
  "stride": 256,
  "engines": [
    "chromium",
    "firefox",
    "webkit"
  ],
  "builds": {
    "store": {
      "dist": "dist",
      "prerequisite": "run.sh"
    },
    "keyed": {
      "dist": "dist-keyed",
      "prerequisite": "keyed-store.sh",
      "externalGeneratedSources": true
    },
    "feed": {
      "dist": "dist-feed",
      "prerequisite": "feed.sh"
    },
    "kiokun": {
      "dist": "dist-kiokun",
      "prerequisite": "kiokun-site.sh"
    },
    "todomvc": {
      "dist": "dist-todomvc",
      "prerequisite": "todomvc.sh"
    },
    "guestbook": {
      "dist": "dist-guestbook",
      "prerequisite": "guestbook.sh"
    },
    "legacy-kiokun": {
      "dist": null,
      "prerequisite": "cargo build -p kiokun-server"
    }
  },
