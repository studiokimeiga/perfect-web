{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "minimumVersion": "3.23.0",
  "entry": [
    "spikes/**/*.mjs",
    "spikes/**/*.js",
    "benchmarks/harness/bench.mjs",
    "benchmarks/harness/test/**/*.mjs",
    "benchmarks/headtohead/head-to-head.mjs",
    "benchmarks/headtohead/feature-change.mjs",
    "benchmarks/headtohead/museum-classes.mjs",
    "benchmarks/headtohead/static-host.mjs",
    "benchmarks/headtohead/playwright.config.mjs",
    "benchmarks/headtohead/todomvc/behaviour.spec.mjs",
    "benchmarks/headtohead/test/**/*.mjs",
    "benchmarks/baselines/sveltekit/vendor/deepmerge/test.cjs",
    "benchmarks/baselines/sveltekit/vendor/deepmerge/consumer-test.cjs",
    "site/build.mjs",
    "site/build.test.mjs",
    "site/www/worker.mjs"
  ],
  "workspaces": {
    "patterns": [
      "spikes/*",
      "benchmarks/*"
    ]
  },
  "ignoreFindings": [
    "spikes/pw-to-marko/src/routes/**",
    "benchmarks/headtohead/todomvc/react/**",
    "benchmarks/headtohead/todomvc/svelte/**"
  ],
  "duplicates": {
    "ignore": [
      "spikes/pw-to-marko/src/routes/**",
      "benchmarks/headtohead/todomvc/react/**",
      "benchmarks/headtohead/todomvc/svelte/**"
    ]
  },
  "health": {
    "ignore": [
      "spikes/pw-to-marko/src/routes/**",
      "benchmarks/headtohead/todomvc/react/**",
      "benchmarks/headtohead/todomvc/svelte/**"
    ]
  },
  "audit": {
    "gate": "new-only"
  }
}
