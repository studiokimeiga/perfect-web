// @status: GENERAL
// @invariant: table_asset_malformed
//
// An owned table keeping an asset: the image an asset names is served to
// anyone who asks for it, so a table whose rows are their owner's keeps
// none.

module Covers

import PostImage
import capability.{ UserId }

type Cover = Cover { owner: UserId, id: Int, image: Option<PostImage.Ref> }

table Covers
    row   Cover
    key   owner, id
    owned by owner
    asset image from PostImage

source CoverData
    holds        Covers
    transactions serializable
    reads        strong
    changes      none
    sets         one_call
