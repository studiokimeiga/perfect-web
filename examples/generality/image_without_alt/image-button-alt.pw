// @status: NEIGHBOUR
// @invariant: image_without_alt
// @dimension: valid neighbour — the same image button, its `alt` saying what it does
module generality.image_button_alt

view SearchForm() !{} {
    <form>
        <label>Find <input type="search" name="q" /></label>
        <input type="image" src="/search.png" alt="Search" />
    </form>
}
