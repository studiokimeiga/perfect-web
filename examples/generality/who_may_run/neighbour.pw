// @status: NEIGHBOUR
// @invariant: who_may_run
// @dimension: valid neighbour — the same command, anyone's to run, its button with no guard
module generality.open_press

opaque type InteractionId = String

type Note = Note { id: String, text: String }

type NoteError =
    | Unavailable

fn save(text: String) -> Result<Note, NoteError> !{ database.write<Note> }
    host "notes:data/notes#save"

command add_note(text: String) -> Result<Note, NoteError>
    requires      Anyone
    idempotent_by InteractionId
    retry         transport_only(max = 2, jitter = true)
{
    save(text)
}

page Notes() {
    route "/notes"

    signal added: Int = 0

    view {
        <title>Notes</title>
        <button type="button" on:press={() => match add_note("Milk") {
            Ok(_) => added = added + 1,
            Err(_) => (),
        }}>Add</button>
    }
}
