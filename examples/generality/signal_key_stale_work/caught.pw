// @status: GENERAL
// @invariant: signal_key_stale_work
// @dimension: indirect invalid — a page of results an `Int` signal keys, its query declaring no `concurrency`
//
// Structurally different from R-027: the key is a number, beside a page's
// parameter, and the query declares no `concurrency`. That is the shape
// `PW0325` let through until ADR-0403, which asked for the policy
// only where a `concurrency` was written.

module generality.results_page

type Hit = Hit { id: String, title: String }

fn hits(term: String, page: Int) -> List<Hit> !{ database.read<Hit> }
    host "search:data/hits#page"

public query Results(term: String, page: Int) -> List<Hit>
    freshness   1.minutes
    consistency snapshot
    cache       shared
    key         term, page
    timeout     2.seconds
{
    hits(term, page)
}

page Find(term: String) {
    route "/find/{term}"
    cache private

    signal page: Int = 1

    let shown = query Results(term, page)

    view {
        <title>Results</title>
        <main>
            <ol>
                {#each shown as hit (hit.id)}
                    <li>{hit.title}</li>
                {/each}
            </ol>
            <button type="button" on:press={() => page = page + 1}>Next</button>
        </main>
    }
}
