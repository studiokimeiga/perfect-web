// @corpus: fixture
// @id: E4-store
// @category: the store page — public store data beside private cart data
// @charter: §14 M4 gate 1, §14 M5 gate 2, §7.8, §9.4
// @milestone: E4/E5
//
// The demo both E4 item 1 and E5 item 2 are blocked on, and the point is the
// SPLIT: one page, two queries, two cache partitions. The store's name and
// menu are the same for everybody and are cached `shared`. The cart belongs to
// one reader, its user (a guest's is its session's guest's), and is cached
// `private`.
//
// What makes this evidence rather than a screenshot: the page renders both,
// and the compiler has already refused to let the private half into the shared
// half — that is `PW5001`, which corpus R-004 exercises with this exact shape.
//
// The Add buttons ARE resumable, and that took a real type-propagation rule
// rather than an adapter guess. `{#each menu as item}` gives `item` the
// element type of what `menu` holds — `Menu` returns `List<MenuItem>`, so
// `item` is a `MenuItem` — which is what lets the capture have a schema.
// Without it `PW5016` refuses to generate a resumable handler at all, which is
// the correct behaviour: serialization, nominal identity, privacy and handler
// compatibility must not rest on a guess.

module store.page

import List
import Stores
import Menus
import Recommender
import Estimates
import UserCarts.{ UserCart }
import UserOrders
import Addresses.{ Address, AddressError, AddressId, AddressLabel, Coverage, Place, PlaceId, address_label }
// The invocation context. `current_session()` was called and never imported
// from E4 until 2026-08-10, and nothing said so: `unresolved_uses` examines
// dotted paths whose head looks like a module, and a bare call to nothing
// contributes nothing to every analysis — which is indistinguishable from a
// call that is harmless. The backend was the first consumer for which the
// absence was fatal.
//
// Adding it is not a formality. `current_session` performs `session.read`, so
// `StorePage` now requires the session to RENDER, and the E8 evidence saying a
// page renders without authority moved with it. That was the architect's
// ruling and the reason the repair waited for a frozen matrix.
import context.{ current_session, current_user }
import domain.{ StoreId, Store, StoreError, CartError, MenuItem, MenuSection, InteractionId,
    MenuItemId, PositiveInt, Recommendation, RecommendationError, DeliveryEstimate,
    EstimateError, OrderStatus, OrderError, TrackingError, Tip, TipError, PromoError,
    Money, USD, is_less, begin_payment, PaymentPage, CancelOrderError, AwaitedPayment }
// NEXT 6c: a payment begun, and settled on the provider's word.
import payments.{ Settled, PaymentStatus, BeginError, CancelError }
// The scheduled-commands track: an order no one pays is taken back. Track
// `scheduled-orders`: an order is for a time, an instant.
import clock.{ minutes, Instant }
import capability.{ Session, SessionId, User, UserId }
import Events.{ MenuChanged, InventoryChanged, UserCartChanged, UserOrderChanged, AddressesChanged, StoreChanged }
// TRACK SEAM (store-hours): each store's hours, and whether it is open.
import store.hours.{ StoreStatus, StoresOpen, CartHours, hours_of_cart, closing_said }
// TRACK SEAM (order-total): the order's total, priced from the store's data.
import store.checkout.{ Priced, Chosen, priced_for, shown_for, promo_for, promo_named, parts_of_cart,
    promo_said, set_tip, set_promo, negative_tip, dollars_typed, total_charged }
// TRACK SEAM (reviews): a store's ratings and reviews, and the stores of the
// reader's order to rate.
import store.reviews.{ StoreRatings, OrderRatings }
// TRACK SEAM (scheduled-orders): an order placed for a time its reader
// chooses, offered by its stores' hours and sent to them when it is due.
import store.scheduled.{ TimesShown, times_shown, checkout_shown, chosen_when, held_to, offered_at,
    timed_for, set_time, when_scheduled, lead_of, lead_for }

// Public. Same answer for every reader, so a shared cache is correct and the
// key is just the store. A change to one store's menu drops that store's kept
// menu and no other (§15.6 test 11, ADR-0164). When the menus' origin fails,
// the last menu kept is shown (§15.6 test 18, ADR-0177): it is every
// reader's, and still true of no one in particular.
public query Menu(id: StoreId) -> Result<List<MenuSection>, StoreError>
    freshness      5.minutes
    consistency    snapshot
    cache          shared
    key            id
    invalidates_on MenuChanged(id), InventoryChanged(id, _)
    concurrency    one_per_key
    on_key_change  cancel
    timeout        2.seconds
    fallback       last_known_good
{
    Menus.sections(id)
}

// **What the recommender suggests for the store** (charter §15.2, §15.3,
// ADR-0165): public, so shared; slow, so streamed, and the page is sent
// before it answers; kept a bounded time, and dropped when the store's menu
// changes, since what it suggests is the menu's (ADR-0164). The accepted
// corpus's form (A-008), but for `fallback`, which a stream's query does not
// run (ADR-0148).
public query Recommendations(id: StoreId) -> Result<List<Recommendation>, RecommendationError>
    freshness      10.minutes
    consistency    eventual
    cache          shared
    key            id
    invalidates_on MenuChanged(id)
    concurrency    one_per_key
    on_key_change  cancel
    delivery       streamed
    timeout        3.seconds
{
    Recommender.for_store(id)
}

// The store, as the menu: public, and its last value kept shown when its
// origin fails (ADR-0177).
public query Store(id: StoreId) -> Result<Store, StoreError>
    freshness     30.seconds
    consistency   snapshot
    cache         shared
    key           id
    concurrency   one_per_key
    on_key_change cancel
    timeout       2.seconds
    fallback      last_known_good
{
    Stores.get(id)
}

// **The menu, counted** (ADR-0277): its sections and its items, derived
// from the menu and kept, every reader's. A change to the store's menu or its
// stock regenerates it, once, and the store's page shows it.
type MenuCount = MenuCount { sections: Int, items: Int }

materialize MenuSize(id: StoreId) -> MenuCount {
    partition      public
    invalidates_on MenuChanged(id), InventoryChanged(id, _)
    regenerate     on_invalidation
    stampede       single_flight
    fallback       last_known_good

    let menu = query Menu(id)
    MenuCount {
        sections: List.length(menu),
        items: List.fold(menu, 0, (n, section) => n + List.length(section.items)),
    }
}

// **What the store's page says of its menu** (ADR-0277): a materialization
// that reads another, so a change regenerates the count before the line, and
// the line is never built from the count before it.
materialize MenuLine(id: StoreId) -> String {
    partition  public
    regenerate on_invalidation
    stampede   single_flight
    fallback   last_known_good

    let size = query MenuSize(id)
    let items = counted(size.items, "item", "items")
    let sections = counted(size.sections, "section", "sections")
    "{items} in {sections}"
}

// **A count, in words**: "1 item", "3 sections".
fn counted(n: Int, one: String, many: String) -> String !{} {
    if n == 1 {
        "1 {one}"
    } else {
        "{n} {many}"
    }
}

// Every store, the same for everybody: public, and cached `shared`
// (ADR-0192).
public query StoreList() -> List<Store>
    freshness   30.seconds
    consistency snapshot
    cache       shared
    concurrency one_per_key
    timeout     2.seconds
{
    Stores.list()
}

// **The reader's own** (track `store-accounts`, ADR-0318): `user`, the
// user's, and importable as a `session` query is. Keyed by
// the reader's handle, which only the host makes (ADR-0263), from the
// session's principal, or the session's own guest where no one signed in
// (ADR-0270). So a user's sessions read one cart, and a guest's cart is its
// session's guest's until the guest signs in, when it joins the user's.
// `cache private`, and the handle's label is what makes putting it in the
// shared cache a compile error rather than a leak nobody notices.
user query Cart(reader: User<UserId>) -> Result<UserCart, CartError>
    freshness      0.seconds
    consistency    read_your_writes
    cache          private
    key            reader
    // Which event concerns this resource. `add_to_cart` declares `invalidates
    // Cart(..)` — that is the COMMAND saying which cache entry it drops — and
    // this is the RESOURCE saying which fact about the world it depends on.
    // They are different statements and the materializer needs the second: it
    // consumes events, and an event nothing declares an interest in reaches
    // nothing.
    //
    // Without this line the graph was correct and the page never updated: the
    // event was emitted, committed, drained, and matched no listener. Found by
    // wiring the real materializer to the browser, which is exactly what the
    // Node stand-in could not have found.
    invalidates_on UserCartChanged(reader)
    concurrency    one_per_key
    on_key_change  cancel
    timeout        2.seconds
{
    UserCarts.current(reader)
}

// **The store's delivery estimate to the reader's chosen address**
// (charter §15.2, §15.3, ADR-0165; track `store-accounts`, ADR-0319): the
// kitchen's and the courier's minutes, or `NoCoverage` where the store does
// not reach it, by the rule `add_to_cart` and `place_order` read. Private,
// and kept for no time: each document's read is its own session's (its
// estimator is a test's, by the session), never another session's of the
// same user. Slow, so streamed; and asked again for each page, and when the
// reader's addresses change.
user query Estimate(id: StoreId, reader: User<UserId>) -> Result<DeliveryEstimate, EstimateError>
    freshness      0.seconds
    consistency    read_your_writes
    cache          private
    key            id, reader
    invalidates_on AddressesChanged(reader)
    concurrency    one_per_key
    on_key_change  cancel
    delivery       streamed
    timeout        3.seconds
{
    Addresses.estimate_to(id, reader)
}

// **The reader's saved addresses** (track `store-accounts`, ADR-0319): the
// user's, or a guest's session's guest's, read again when they change.
user query SavedAddresses(reader: User<UserId>) -> List<Address>
    freshness      0.seconds
    consistency    read_your_writes
    cache          private
    key            reader
    invalidates_on AddressesChanged(reader)
    concurrency    one_per_key
    on_key_change  cancel
    timeout        2.seconds
{
    Addresses.mine(reader)
}

// **The places an address may name**: the store's fixed table, every
// reader's.
public query Places() -> List<Place>
    freshness   1.hours
    consistency snapshot
    cache       shared
    concurrency one_per_key
    timeout     2.seconds
{
    Addresses.places()
}

// **Whether the store reaches the reader's chosen address** (track
// `store-accounts`): what its page says where the menu is.
user query Reach(id: StoreId, reader: User<UserId>) -> Coverage
    freshness      0.seconds
    consistency    read_your_writes
    cache          private
    key            id, reader
    invalidates_on AddressesChanged(reader)
    concurrency    one_per_key
    on_key_change  cancel
    timeout        2.seconds
{
    Addresses.coverage(id, reader)
}

// **The reader's order**, as the store last said of it (ADR-0193): the
// user's alone, read by their handle as a notification is (ADR-0274,
// ADR-0318), and read again whenever the store moves it along.
user query Order(reader: User<UserId>) -> Result<Option<OrderStatus>, TrackingError>
    freshness      0.seconds
    consistency    read_your_writes
    cache          private
    key            reader
    invalidates_on UserOrderChanged(reader)
    concurrency    one_per_key
    on_key_change  cancel
    timeout        2.seconds
{
    UserOrders.current(reader)
}

// **The reader's checkout** (track `order-total`): the cart priced from the
// store's data, each store's fees and tax, the code applied and the tip
// chosen, and what the page says of the code. Read again when the cart, a
// choice or a store's data changes, or the clock passes a code's expiry. And
// (track `scheduled-orders`) when the order is for, read again when the time
// chosen is an hour away, or the reader's address changes: a time chosen is
// held to the windows, which wait for the estimates to it. A cart for as soon
// as possible asks no estimate.
user query Checkout(reader: User<UserId>) -> Priced
    freshness      0.seconds
    consistency    read_your_writes
    cache          private
    key            reader
    invalidates_on UserCartChanged(reader), UserOrderChanged(reader), StoreChanged(_), AddressesChanged(reader)
    concurrency    one_per_key
    on_key_change  cancel
    timeout        2.seconds
{
    checkout_shown(reader)
}

// **The times the reader may choose** (track `scheduled-orders`): the cart's
// stores' fifteen-minute windows from an hour to a week ahead, those every
// store takes an order for as soon as possible at when they are told, by
// their hours; one day's shown. The reader's, read again when the cart, a
// store's hours or the reader's address change (the estimates the lead
// is), or the first window's hour comes.
user query TimesOffered(reader: User<UserId>, day: Option<String>) -> TimesShown
    freshness      0.seconds
    consistency    read_your_writes
    cache          private
    key            reader, day
    invalidates_on UserCartChanged(reader), StoreChanged(_), AddressesChanged(reader)
    concurrency    one_per_key
    on_key_change  cancel
    timeout        2.seconds
{
    let stores = hours_of_cart(reader)
    times_shown(stores, chosen_when(reader), day, lead_of(stores, reader))
}

// **What the reader's order was charged** (track `order-total`): its total,
// or none where none is placed, read through the order's arm (ADR-0330,
// track `store-switch`).
user query OrderTotal(reader: User<UserId>) -> Option<Money<USD>>
    freshness      0.seconds
    consistency    read_your_writes
    cache          private
    key            reader
    invalidates_on UserOrderChanged(reader)
    concurrency    one_per_key
    on_key_change  cancel
    timeout        2.seconds
{
    total_charged(UserOrders.charged(reader))
}

// **Who may place an order** (ADR-0307; track `store-accounts`): a reader
// signed in, as `place_order` requires, declared here so the cart's page
// asks it of its reader and shows Place order where it holds. A cart is
// anyone's to change, a guest's its session's guest's, so its other
// controls ask nothing.
predicate SignedIn
    says "Sign in to place an order."

// The mutation, as charter §15.4 asks. Idempotent by interaction id, so a
// resend adds only once. Transactional. Optimistic, so the count moves before
// the round trip, and moves back if the add is refused. And the item's
// availability is read again inside it: an item sold out since the page was
// rendered is refused by name, and the page is told which (ADR-0157).
//
// It takes the item as the page showed it (ADR-0172): a new line is made from
// its name and its price before the server answers. The command writes by the
// item's id alone, and the data layer records the item's own name and price.
//
// **Anyone may fill a cart** (track `store-accounts`, ADR-0318): a reader
// signed in fills their user's, and a guest its session's guest's, which joins
// its user's when the guest signs in. So the cart's commands require no one
// signed in; placing an order does. A press from a page shown to another
// reader (a tab whose reader signed in or out in another) is refused by the
// platform before any command runs (docs/PARALLEL.md, Q3).
command add_to_cart(item: MenuItem, quantity: PositiveInt)
    -> Result<UserCart, CartError>
    requires      Anyone
    idempotent_by InteractionId
    retry         transport_only(max = 2, jitter = true)
    transaction   serializable
    optimistic    Cart(current_user()) as cart => UserCarts.with_line(cart, item, quantity)
    invalidates   Cart(current_user())
    emits         UserCartChanged(current_user())
{
    if !Menus.is_available(item.id) {
        return Err(CartError.ItemUnavailable(item.id))
    }
    // The store's own rule about its own data (track `store-accounts`): an
    // item from a store that does not reach the reader's chosen address is
    // refused, by the rule the estimate reads.
    if !Addresses.reaches(item.store_id, current_user()) {
        return Err(CartError.OutOfRange(item.store_id))
    }
    UserCarts.add(current_user(), item.id, quantity)
}

// **One more of a line's item** (charter §15.3, ADR-0172). A step, not a
// quantity: two presses before the first answers are two. As `add_to_cart`,
// the item's availability is read again inside it.
command increase_in_cart(item: MenuItemId)
    -> Result<UserCart, CartError>
    requires      Anyone
    idempotent_by InteractionId
    retry         transport_only(max = 2, jitter = true)
    transaction   serializable
    optimistic    Cart(current_user()) as cart => UserCarts.with_more(cart, item)
    invalidates   Cart(current_user())
    emits         UserCartChanged(current_user())
{
    if !Menus.is_available(item) {
        return Err(CartError.ItemUnavailable(item))
    }
    UserCarts.add(current_user(), item, PositiveInt(1))
}

// **One fewer of a line's item** (charter §15.3, ADR-0172): at one, the
// line goes.
command decrease_in_cart(item: MenuItemId)
    -> Result<UserCart, CartError>
    requires      Anyone
    idempotent_by InteractionId
    retry         transport_only(max = 2, jitter = true)
    optimistic    Cart(current_user()) as cart => UserCarts.with_fewer(cart, item)
    invalidates   Cart(current_user())
    emits         UserCartChanged(current_user())
{
    UserCarts.decrease(current_user(), item)
}

// **A line, gone** (charter §15.3, ADR-0172).
command remove_from_cart(item: MenuItemId)
    -> Result<UserCart, CartError>
    requires      Anyone
    idempotent_by InteractionId
    retry         transport_only(max = 2, jitter = true)
    optimistic    Cart(current_user()) as cart => UserCarts.without(cart, item)
    invalidates   Cart(current_user())
    emits         UserCartChanged(current_user())
{
    UserCarts.remove(current_user(), item)
}

// A SECOND handler on the same page, and the reason it exists is E7-L.
//
// "The exact handler is fetched" is unfalsifiable with one handler: any fetch
// is the right fetch. With two, the page can be made to demonstrate that
// pressing Add loads `add_to_cart` and leaves `clear_cart` unfetched — which is
// the whole claim, and the one thing a single-handler demo cannot show.
command clear_cart()
    -> Result<UserCart, CartError>
    requires      Anyone
    idempotent_by InteractionId
    retry         transport_only(max = 2, jitter = true)
    invalidates   Cart(current_user())
    emits         UserCartChanged(current_user())
{
    UserCarts.clear(current_user())
}

// **The reader's cart, placed as their order** (ADR-0193): the order is the
// cart's lines, and the cart is empty after, in one commit. An empty cart
// places nothing, and says so. A guest signs in to order (track
// `store-accounts`): an order is a user's, followed from any of their
// sessions, and the guest's cart follows them in.
command place_order(shown: Money<USD>)
    -> Result<OrderStatus, OrderError>
    requires      SignedIn
    idempotent_by InteractionId
    retry         transport_only(max = 2, jitter = true)
    transaction   serializable
    invalidates   Cart(current_user()), Order(current_user()), Checkout(current_user()), OrderTotal(current_user())
    emits         UserCartChanged(current_user()), UserOrderChanged(current_user())
{
    // TRACK SEAM (scheduled-orders): the time chosen at checkout, none for as
    // soon as possible, and the cart's stores' hours, read in this
    // transaction.
    let when = chosen_when(current_user())
    let hours = hours_of_cart(current_user())
    // The stores are told `lead` before a time (none for as soon as possible,
    // which asks no estimate).
    let lead = lead_for(hours, when, current_user())
    // TRACK SEAM (store-hours): refused while a store of the cart is closed
    // or past its last order. TRACK SEAM (scheduled-orders): an order for a
    // time is held to the times offered now instead, so a store closed now
    // takes one for a time it would take one.
    match held_to(hours, when, lead) {
        Some(refused) => Err(refused),
        // TRACK SEAM (order-total): priced again from the data, in this
        // transaction, never from the page's numbers; refused where the code
        // no longer applies, or the total is not the one the reader was
        // shown (the integrator's ruling of 2026-10-13).
        None => match priced_for(current_user()) {
            Err(e) => Err(OrderError.Promo(e)),
            Ok(p) => if is_less(p.charged.total, shown) | is_less(shown, p.charged.total) {
                Err(OrderError.TotalChanged(p.charged.total))
            } else {
                // NEXT 6c: awaiting its payment, placed once it is paid, where
                // the deployment takes payments; at once where it takes none.
                // TRACK SEAM (scheduled-orders): with its time, where it is
                // for one, and when its stores are to be told.
                match UserOrders.await_payment(current_user(), p.charged, p.promo, timed_for(hours, when, lead)) {
                    Err(e) => Err(e),
                    Ok(order) => match begin_payment(order, p.charged.total) {
                        // Taken back thirty minutes on where no one has paid
                        // or taken it back since (the scheduled-commands
                        // track, ADR-0332's sweep).
                        Ok(payment) => {
                            schedule expire_order(order) after minutes(30)
                            UserOrders.paying(current_user(), order, payment)
                        },
                        // TRACK SEAM (scheduled-orders): paid at once, an
                        // order for a time is sent to its stores when it is
                        // due, and they are told nothing before.
                        Err(BeginError.NotTaken) => match UserOrders.settle(current_user(), order, PaymentStatus.Succeeded) {
                            Ok(OrderStatus.Scheduled(s)) => {
                                schedule send_to_store(order) at s.sends
                                Ok(OrderStatus.Scheduled(s))
                            },
                            settled => settled,
                        },
                        Err(BeginError.TransportFailed) => Err(OrderError.PaymentUnavailable),
                    },
                }
            },
        },
    }
}

// **A payment settled, as the provider says it** (NEXT 6c): invoked by the
// platform once it has its provider's word, on behalf of the reader who
// began the payment, never pressed. Placed where it succeeded, its cart's
// other pages told, or scheduled where it is for a time (track
// `scheduled-orders`); awaiting still where it has not yet.
command settle_payment(settled: Settled)
    -> Result<OrderStatus, OrderError>
    invoked_by    Payments
    idempotent_by InteractionId
    transaction   serializable
    invalidates   Cart(current_user()), Order(current_user()), Checkout(current_user()), OrderTotal(current_user())
    emits         UserCartChanged(current_user()), UserOrderChanged(current_user())
{
    // Paid, or given up: no order is left to take back (the
    // scheduled-commands track). One waiting still, for a card or the bank,
    // keeps its sweep.
    if settled_for_good(settled.status) {
        unschedule expire_order(settled.order)
    }
    // TRACK SEAM (scheduled-orders): paid, an order for a time is sent to its
    // stores when it is due, and they are told nothing before.
    match UserOrders.settle(current_user(), settled.order, settled.status) {
        Ok(OrderStatus.Scheduled(s)) => {
            schedule send_to_store(settled.order) at s.sends
            Ok(OrderStatus.Scheduled(s))
        },
        other => other,
    }
}

// **Whether a payment's status is its last**: paid, or given up.
fn settled_for_good(status: PaymentStatus) -> Bool !{} {
    match status {
        PaymentStatus.Succeeded => true,
        PaymentStatus.Canceled => true,
        _ => false,
    }
}

// **An order awaiting its payment, taken back by its reader** (NEXT 6c, step
// eight): its payment canceled at the provider, then the order canceled, its
// lines back in the cart and its code's use released. Where the provider
// says the payment is past canceling, the order stands, and the provider's
// word places it.
command cancel_order()
    -> Result<OrderStatus, CancelOrderError>
    requires      SignedIn
    idempotent_by InteractionId
    transaction   serializable
    invalidates   Cart(current_user()), Order(current_user()), Checkout(current_user()), OrderTotal(current_user())
    emits         UserCartChanged(current_user()), UserOrderChanged(current_user())
{
    match UserOrders.awaited(current_user()) {
        None => Err(CancelOrderError.NotAwaitingPayment),
        // Taken back, it is not swept (the scheduled-commands track).
        Some(awaited) => {
            unschedule expire_order(awaited.order)
            take_back(current_user(), awaited)
        },
    }
}

// **An order no one paid, taken back** (the scheduled-commands track,
// ADR-0332's sweep): run by the clock thirty minutes after its reader placed
// it awaiting its payment, on their behalf, as their cancel takes it back.
// Paid or taken back since, it is no longer awaiting, and stands as it is.
command expire_order(order: String)
    -> Result<OrderStatus, CancelOrderError>
    invoked_by    Clock
    idempotent_by InteractionId
    transaction   serializable
    invalidates   Cart(current_user()), Order(current_user()), Checkout(current_user()), OrderTotal(current_user())
    emits         UserCartChanged(current_user()), UserOrderChanged(current_user())
{
    match UserOrders.awaited(current_user()) {
        Some(awaited) => if awaited.order == order {
            take_back(current_user(), awaited)
        } else {
            Err(CancelOrderError.NotAwaitingPayment)
        },
        None => Err(CancelOrderError.NotAwaitingPayment),
    }
}

// **An order awaiting its payment, taken back for `reader`** (NEXT 6c, step
// eight): its payment canceled at the provider, then the order canceled, its
// lines back in the cart and its code's use released. Where the provider
// says the payment is past canceling, the order stands, and the provider's
// word places it.
fn take_back(reader: User<UserId>, awaited: AwaitedPayment) -> Result<OrderStatus, CancelOrderError> {
    match payments.cancel(awaited.payment) {
        Ok(_) => match UserOrders.settle(reader, awaited.order, PaymentStatus.Canceled) {
            Ok(status) => Ok(status),
            // Its order gone since it was read: none to take back.
            Err(_) => Err(CancelOrderError.NotAwaitingPayment),
        },
        Err(CancelError.Past(_)) => Err(CancelOrderError.Paid),
        Err(CancelError.TransportFailed) => Err(CancelOrderError.PaymentUnavailable),
    }
}

// **The tip the reader chooses** (track `order-total`): none, 15, 18 or 20
// percent of the subtotal, or an amount, a case a browser sends (ADR-0331,
// track `store-switch`). None until they choose. An amount below nothing is
// refused: Money carries no invariant.
command choose_tip(tip: Tip)
    -> Result<Tip, TipError>
    requires      Anyone
    idempotent_by InteractionId
    retry         transport_only(max = 2, jitter = true)
    transaction   serializable
    invalidates   Checkout(current_user())
    emits         UserCartChanged(current_user())
{
    if negative_tip(tip) {
        return Err(TipError.NegativeTip)
    }
    Ok(set_tip(current_user(), tip).tip)
}

// **A promo code applied to the cart** (track `order-total`), or why not,
// by name: unknown, expired, used, its store not in the cart, or under its
// least subtotal.
command apply_promo(code: String)
    -> Result<Chosen, PromoError>
    requires      Anyone
    idempotent_by InteractionId
    retry         transport_only(max = 2, jitter = true)
    transaction   serializable
    invalidates   Checkout(current_user())
    emits         UserCartChanged(current_user())
{
    match promo_for(promo_named(current_user(), code), parts_of_cart(current_user())) {
        Ok(_) => Ok(set_promo(current_user(), Some(code))),
        Err(e) => Err(e),
    }
}

// **The cart's promo code taken off** (track `order-total`).
command remove_promo()
    -> Result<Chosen, PromoError>
    requires      Anyone
    idempotent_by InteractionId
    retry         transport_only(max = 2, jitter = true)
    transaction   serializable
    invalidates   Checkout(current_user())
    emits         UserCartChanged(current_user())
{
    Ok(set_promo(current_user(), None))
}

// **When the order is for** (track `scheduled-orders`), a checkout choice as
// the tip is: none for as soon as possible, or one of the times offered now,
// held to them in this transaction. A time not offered now is refused by
// name.
command choose_time(when: Option<Instant>)
    -> Result<Option<Instant>, OrderError>
    requires      Anyone
    idempotent_by InteractionId
    retry         transport_only(max = 2, jitter = true)
    transaction   serializable
    invalidates   Checkout(current_user())
    emits         UserCartChanged(current_user())
{
    match when {
        Some(at) => {
            let hours = hours_of_cart(current_user())
            if offered_at(hours, at, lead_of(hours, current_user())) {
                Ok(set_time(current_user(), when).when)
            } else {
                Err(OrderError.NotOffered(at))
            }
        },
        None => Ok(set_time(current_user(), None).when),
    }
}

// **An order for a time, sent to its stores** (track `scheduled-orders`):
// run by the clock when its preparation is due, on its reader's behalf, and
// placed then as an order for as soon as possible is placed at once: its
// stores have it, and its reader's pages are told, once. An order no longer
// scheduled, or another, stands as it is.
command send_to_store(order: String)
    -> Result<OrderStatus, OrderError>
    invoked_by    Clock
    idempotent_by InteractionId
    transaction   serializable
    invalidates   Order(current_user())
    emits         UserOrderChanged(current_user())
{
    UserOrders.send(current_user(), order)
}

// **An address saved, and chosen as it is saved** (track `store-accounts`,
// ADR-0319): a label and a place from the table. What a store reaches and its
// estimate depend on it, in each of the reader's sessions.
command add_address(label: AddressLabel, place: PlaceId)
    -> Result<List<Address>, AddressError>
    requires      Anyone
    idempotent_by InteractionId
    retry         transport_only(max = 2, jitter = true)
    transaction   serializable
    invalidates   SavedAddresses(current_user())
    emits         AddressesChanged(current_user())
{
    Addresses.add(current_user(), label, place)
}

// **An address's label, changed.**
command rename_address(id: AddressId, label: AddressLabel)
    -> Result<List<Address>, AddressError>
    requires      Anyone
    idempotent_by InteractionId
    retry         transport_only(max = 2, jitter = true)
    invalidates   SavedAddresses(current_user())
    emits         AddressesChanged(current_user())
{
    Addresses.rename(current_user(), id, label)
}

// **An address, gone**: the chosen one leaves none chosen.
command remove_address(id: AddressId)
    -> Result<List<Address>, AddressError>
    requires      Anyone
    idempotent_by InteractionId
    retry         transport_only(max = 2, jitter = true)
    invalidates   SavedAddresses(current_user())
    emits         AddressesChanged(current_user())
{
    Addresses.remove(current_user(), id)
}

// **An address chosen for deliveries.**
command choose_address(id: AddressId)
    -> Result<List<Address>, AddressError>
    requires      Anyone
    idempotent_by InteractionId
    retry         transport_only(max = 2, jitter = true)
    invalidates   SavedAddresses(current_user())
    emits         AddressesChanged(current_user())
{
    Addresses.choose(current_user(), id)
}

// **What every page of the store is shown in** (ADR-0303): the way home,
// and the reader's cart, its count told as the cart changes, whichever page
// is open. Its own markup and bindings, the same on every page that names it;
// read again with every document, so a page gone to after a change shows it.
// The reader's user's (track `store-accounts`), as the pages' cart is: a
// page declares at least its layout's audience (PW5046), and the store's
// pages are `user` pages.
user layout StoreLayout {
    let cart = query Cart(current_user())

    view {
        <header>
            <nav aria-label="Store">
                <a href="/">Stores</a>
                <a id="header-cart" href="/cart">Cart <span id="header-cart-count">{cart.line_count}</span></a>
            </nav>
        </header>
        <slot />
    }
}

// Private to the reader's user (ADR-0172; track `store-accounts`): its cart's
// lines are the user's, and its handlers capture them, so a resume manifest
// must say to whom what it carries is private. `cache private` alone names no
// one; `user` names the user, as `session` named the session.
user page StorePage(id: StoreId) {
    // Charter §15.3: the store's address, which gives its id (ADR-0160),
    // and an id that names no store is not found (ADR-0163).
    route        "/stores/{id}"
    not_found_on StoreError.NotFound
    layout       StoreLayout
    placement    origin
    cache        private

    let store = query Store(id)
    let menu = query Menu(id)
    let line = query MenuLine(id)
    // TRACK SEAM (store-hours): whether the store is open.
    let open = query StoreStatus(id)
    let cart = query Cart(current_user())
    // Whether the store reaches the reader's chosen address (track
    // `store-accounts`).
    let reach = query Reach(id, current_user())
    // TRACK SEAM (reviews): what its ratings come to, and its reviews.
    let ratings = query StoreRatings(id)
    // What the cart last had to say: a refusal of an add or a clear.
    signal notice: String = ""
    // Charter §15.3's slots (ADR-0165), the estimate and the recommendations,
    // are each a `<stream>`: they come in the same response, after the
    // store's own content, and hold up neither it nor an Add. The estimate,
    // when it comes, is said to a screen reader: a range, "25 to 35", in
    // words, since an en dash between two numbers is read unreliably
    // (ADR-0180).

    view {
        <!-- What the page is: the store's name, which a screen reader says
             first and a tab shows (ADR-0183). -->
        <title>{store.name}</title>
        <!-- What it says of itself to a search engine's result and a link's
             preview (ADR-0186). -->
        <meta name="description" content={store.description} />
        <main>
            <h1 id="store-name">{store.name}</h1>
            <p id="store-cuisine">{store.cuisine}</p>
            <p id="store-open">{open.said}</p>
            <p id="store-rating">{ratings.said}</p>
            <p id="store-description">{store.description}</p>
            <p id="menu-line">{line}</p>

            <!-- Where deliveries go, and whether this store reaches it (track
                 `store-accounts`), said where the menu is. -->
            <p id="deliver-to">
                {#if reach.chosen}Delivering to {reach.to}{:else}No delivery address yet{/if}
                <a id="change-address" href="/stores/{id}/address">Change the address</a>
            </p>
            {#if reach.delivers}{:else}<p id="out-of-range">{store.name} doesn't deliver to {reach.to}.</p>{/if}

            <section aria-label="Delivery" aria-live="polite">
                <stream query={Estimate(id, current_user())}>
                    <placeholder><p>Estimating delivery</p></placeholder>
                    <ready as={estimate}><p>Delivery in {estimate.min_minutes} to {estimate.max_minutes} min</p></ready>
                    <failed><p>Delivery estimate unavailable</p></failed>
                </stream>
            </section>

            <section aria-label="Menu">
                <!-- Grouped by category, each a heading and its items (ADR-0181). -->
                <div id="menu">
                    {#each menu as section (section.category.id)}
                        <h2>{section.category.name}</h2>
                        <ul>
                            {#each section.items as item (item.id)}
                                <li>
                                    <span>{item.name}</span>
                                    <p>{item.description}</p>
                                    <p>{item.price.display}</p>
                                    <!-- Whether it can be ordered, before the press (ADR-0178). -->
                                    {#if item.available}
                                        <!-- In the menu every reader is served alike (E7-P), so
                                             no reader's answer decides it: shown to each, and a
                                             refusal told where the press was (ADR-0307). -->
                                        <button
                                            type="button"
                                            aria-label="Add {item.name}"
                                            on:press|refusable={resumable(captures = { item }) => match add_to_cart(item, PositiveInt(1)) {
                                                Ok(_) => notice = "",
                                                Err(CartError.ItemUnavailable(_)) => notice = "That item just sold out.",
                                                Err(CartError.OutOfRange(_)) => notice = "This store doesn't deliver to your address.",
                                                Err(_) => notice = "That item could not be added.",
                                            }}
                                        >
                                            Add
                                        </button>
                                    {:else}
                                        <p>Sold out</p>
                                    {/if}
                                </li>
                            {/each}
                        </ul>
                    {/each}
                </div>
            </section>

            <section aria-labelledby="cart-heading">
                <!-- Focus comes here when the line that had it goes (ADR-0172). -->
                <h2 id="cart-heading" tabindex="-1">Cart</h2>
                <p aria-live="polite" aria-atomic="true">Items in cart: <span id="cart-count">{cart.line_count}</span></p>
                <p id="cart-empty" hidden={cart.lines}>Your cart is empty.</p>
                <ul id="cart-lines">
                    {#each cart.lines as line (line.item_id)}
                        <li>
                            <span>{line.name}</span>
                            <button
                                type="button"
                                aria-label="Decrease quantity of {line.name}"
                                on:press={resumable(captures = { line }) => match decrease_in_cart(line.item_id) {
                                    Ok(_) => notice = "",
                                    Err(_) => notice = "That line could not be changed.",
                                }}
                            >
                                −
                            </button>
                            <span>{line.quantity.count}</span>
                            <button
                                type="button"
                                aria-label="Increase quantity of {line.name}"
                                on:press={resumable(captures = { line }) => match increase_in_cart(line.item_id) {
                                    Ok(_) => notice = "",
                                    Err(CartError.ItemUnavailable(_)) => notice = "That item just sold out.",
                                    Err(_) => notice = "That line could not be changed.",
                                }}
                            >
                                +
                            </button>
                            <span>{line.total.display}</span>
                            <button
                                type="button"
                                aria-label="Remove {line.name}"
                                on:press={resumable(captures = { line }) => match remove_from_cart(line.item_id) {
                                    Ok(_) => notice = "",
                                    Err(_) => notice = "That line could not be removed.",
                                }}
                            >
                                Remove
                            </button>
                        </li>
                    {/each}
                </ul>
                <p>Subtotal: <span id="cart-subtotal">{cart.subtotal.display}</span></p>
                {#if cart.lines}<p id="cart-fees">Delivery fee and taxes are added at checkout.</p>{/if}
                <p id="cart-notice" role="status">{notice}</p>
                <button
                    id="clear-cart"
                    type="button"
                    on:press={resumable() => match clear_cart() {
                        Ok(_) => notice = "",
                        Err(_) => notice = "The cart could not be cleared.",
                    }}
                >
                    Clear
                </button>
                <!-- The cart as a page of its own (ADR-0190), where an order is
                     placed: "Checkout" with its subtotal while the cart holds
                     a line (ADR-0323, a member read inside a block). -->
                <p>{#if cart.lines}<a id="checkout" href="/cart">Checkout {cart.subtotal.display}</a>{:else}<a id="cart-page" href="/cart">Go to your cart</a>{/if}</p>
            </section>

            <section aria-label="Recommendations">
                <stream query={Recommendations(id)}>
                    <placeholder><p>Finding recommendations</p></placeholder>
                    <ready as={items}>
                        <ul>
                            {#each items as item (item.id)}
                                <li>{item.name}</li>
                            {/each}
                        </ul>
                    </ready>
                    <failed><p>No recommendations right now</p></failed>
                </stream>
            </section>

            <!-- TRACK SEAM (reviews): what its customers said, each from a
                 delivered order, without who said it (ADR-0341). -->
            <section aria-labelledby="reviews-heading">
                <h2 id="reviews-heading">What customers said</h2>
                {#if ratings.reviews}
                    <ul id="reviews">
                        {#each ratings.reviews as review (review.id)}
                            <li><p class="stars">{review.stars} out of 5</p><p class="comment">{review.comment}</p></li>
                        {/each}
                    </ul>
                {:else}
                    <p id="no-reviews">No reviews yet.</p>
                {/if}
            </section>
        </main>
    }
}

// **The cart, as a page of its own** (ADR-0190): the session's lines, each
// one's quantity changed or the line removed, and the cart cleared. The
// store's page shows the same cart beside its menu, and a change made on
// either reaches the other while both are open: each reads
// `Cart(current_user())`, and the server derives what each shows from its
// own plan. Until 2026-10-04 a page that bound a query was served only at the
// store's route.
user page CartPage() {
    route     "/cart"
    layout    StoreLayout
    placement origin
    cache     private

    let cart = query Cart(current_user())
    // Its order, once it is placed (ADR-0193).
    let order = query Order(current_user())
    // TRACK SEAM (store-hours): its stores' hours, where one is closed.
    let hours = query CartHours(current_user())
    // TRACK SEAM (order-total): its total, each charge.
    let checkout = query Checkout(current_user())
    // What the cart last had to say: a line that could not be changed.
    signal notice: String = ""
    // A promo code, and a tip in dollars, as the reader types them.
    signal code: String = ""
    signal tip_typed: String = ""

    view {
        <title>Your cart</title>
        <main>
            <h1 id="cart-heading" tabindex="-1">Your cart</h1>
            <p aria-live="polite" aria-atomic="true">Items in cart: <span id="cart-count">{cart.line_count}</span></p>
            <p id="cart-empty" hidden={cart.lines}>Your cart is empty.</p>
            <ul id="cart-lines">
                {#each cart.lines as line (line.item_id)}
                    <li>
                        <span>{line.name}</span>
                        <button
                            type="button"
                            aria-label="Decrease quantity of {line.name}"
                            on:press={resumable(captures = { line }) => match decrease_in_cart(line.item_id) {
                                Ok(_) => notice = "",
                                Err(_) => notice = "That line could not be changed.",
                            }}
                        >
                            −
                        </button>
                        <span>{line.quantity.count}</span>
                        <button
                            type="button"
                            aria-label="Increase quantity of {line.name}"
                            on:press={resumable(captures = { line }) => match increase_in_cart(line.item_id) {
                                Ok(_) => notice = "",
                                Err(CartError.ItemUnavailable(_)) => notice = "That item just sold out.",
                                Err(_) => notice = "That line could not be changed.",
                            }}
                        >
                            +
                        </button>
                        <span>{line.total.display}</span>
                        <button
                            type="button"
                            aria-label="Remove {line.name}"
                            on:press={resumable(captures = { line }) => match remove_from_cart(line.item_id) {
                                Ok(_) => notice = "",
                                Err(_) => notice = "That line could not be removed.",
                            }}
                        >
                            Remove
                        </button>
                    </li>
                {/each}
            </ul>
            <p>Subtotal: <span id="cart-subtotal">{cart.subtotal.display}</span></p>
            <!-- TRACK SEAM (order-total): the total, each charge under a
                 disclosure; a promo code; a tip, none until the reader
                 chooses one, and no choice shown as chosen before. -->
            {#if checkout.any}<details id="cart-fees">
                <summary>Total <span id="checkout-total">{checkout.charges.total.display}</span></summary>
                <dl id="checkout-charges">
                    <dt>Subtotal</dt><dd id="charge-subtotal">{checkout.charges.subtotal.display}</dd>
                    <dt>Promo</dt><dd id="charge-discount">{checkout.discount_said}</dd>
                    <dt>Delivery fee</dt><dd id="charge-delivery">{checkout.charges.delivery.display}</dd>
                    <dt>Service fee</dt><dd id="charge-service">{checkout.charges.service.display}</dd>
                    <dt>Small order fee</dt><dd id="charge-small">{checkout.charges.small_order.display}</dd>
                    <dt>Estimated tax</dt><dd id="charge-tax">{checkout.charges.tax.display}</dd>
                    <dt>Tip</dt><dd id="charge-tip">{checkout.charges.tip.display}</dd>
                </dl>
            </details>{/if}
            <p id="promo">
                <label>Promo code <input id="promo-code" type="text" bind:value={code} /></label>
                <button
                    id="apply-promo"
                    type="button"
                    on:press={resumable() => match apply_promo(code) {
                        Ok(_) => notice = "",
                        Err(e) => notice = promo_said(e),
                    }}
                >
                    Apply
                </button>
            </p>
            <p id="promo-said">{checkout.said}</p>
            {#match checkout.promo}
            {:Some(_)}<button
                id="remove-promo"
                type="button"
                on:press={resumable() => match remove_promo() {
                    Ok(_) => notice = "",
                    Err(e) => notice = promo_said(e),
                }}
            >
                Remove code
            </button>
            {:None}
            {/match}
            <fieldset id="tips">
                <legend>Tip your courier</legend>
                <button type="button" id="tip-none" on:press={resumable() => match choose_tip(Tip.NoTip) {
                    Ok(_) => notice = "",
                    Err(_) => notice = "That tip could not be chosen.",
                }}>No tip</button>
                <button type="button" id="tip-15" on:press={resumable() => match choose_tip(Tip.Fifteen) {
                    Ok(_) => notice = "",
                    Err(_) => notice = "That tip could not be chosen.",
                }}>15%</button>
                <button type="button" id="tip-18" on:press={resumable() => match choose_tip(Tip.Eighteen) {
                    Ok(_) => notice = "",
                    Err(_) => notice = "That tip could not be chosen.",
                }}>18%</button>
                <button type="button" id="tip-20" on:press={resumable() => match choose_tip(Tip.Twenty) {
                    Ok(_) => notice = "",
                    Err(_) => notice = "That tip could not be chosen.",
                }}>20%</button>
                <label>Other amount <input id="tip-amount" type="text" inputmode="decimal" bind:value={tip_typed} /></label>
                <button type="button" id="tip-other" on:press={resumable() => match dollars_typed(tip_typed) {
                    Some(amount) => match choose_tip(Tip.TipAmount(amount)) {
                        Ok(_) => notice = "",
                        Err(_) => notice = "That tip could not be chosen.",
                    },
                    None => notice = "Enter a tip in dollars and cents, like 4.50.",
                }}>Add tip</button>
            </fieldset>
            <p id="cart-hours">{hours}</p>
            <!-- TRACK SEAM (scheduled-orders): when the order is for, as soon
                 as possible or a time chosen, and where another is chosen. -->
            {#if checkout.any}<p id="cart-when">{checkout.when_said} <a id="choose-when" href="/cart/when">Choose a time</a></p>{/if}
            <p id="cart-notice" role="status">{notice}</p>
            <button
                id="clear-cart"
                type="button"
                on:press={resumable() => match clear_cart() {
                    Ok(_) => notice = "",
                    Err(_) => notice = "The cart could not be cleared.",
                }}
            >
                Clear
            </button>
            <!-- The cart, placed as an order (ADR-0193). -->
            {#if SignedIn}<button
                id="place-order"
                type="button"
                on:press={resumable(captures = { checkout }) => match place_order(checkout.charges.total) {
                    Ok(_) => navigate OrderPage(),
                    Err(OrderError.NothingToOrder) => notice = "Your cart is empty: there is nothing to order.",
                    Err(OrderError.NoCoverage) => notice = "A store in your cart doesn't deliver to your address.",
                    Err(OrderError.Closed(closing)) => notice = "A store in your cart {closing_said(closing)}.",
                    Err(OrderError.Promo(e)) => notice = promo_said(e),
                    Err(OrderError.TotalChanged(now)) => notice = "Your total is now {now.display}. Check it, and place your order again.",
                    // NEXT 6c: an order of theirs awaits its payment, on its page.
                    Err(OrderError.AwaitingPayment) => notice = "An order of yours awaits its payment: pay it on your order's page.",
                    Err(OrderError.PaymentUnavailable) => notice = "Payment is unavailable just now. Try again in a moment.",
                    // Track `scheduled-orders`: the time chosen is an hour
                    // away or less, or a store would take no order when its
                    // stores are told; the times offered now are on its page.
                    Err(OrderError.NotOffered(_)) => notice = "The time you chose is no longer offered: choose another.",
                    Err(OrderError.Scheduled) => notice = "An order of yours is scheduled: you can place another once it is sent to its store.",
                }}
            >
                Place order
            </button>{/if}
            {#match order}
            {:Some(_)}<p id="order-link"><a href="/order">Follow your order</a></p>
            {:None}
            {/match}
        </main>
    }
}

// **When the order is for** (track `scheduled-orders`): as soon as possible,
// or one of the times offered now, fifteen-minute windows by day, one day's
// at a time, the day its address names (ADR-0309). Chosen, the reader is
// back at the cart. The windows are the program's (`store.scheduled`),
// computed by comparing the clock, never by the page.
user page TimePage(day: Option<String>) {
    route     "/cart/when{?day}"
    layout    StoreLayout
    placement origin
    cache     private

    let times = query TimesOffered(current_user(), day)
    // Why a time was not chosen.
    signal notice: String = ""

    view {
        <title>When to deliver</title>
        <main>
            <h1>When to deliver</h1>
            <p id="when-said">{times.said}</p>
            <button
                id="when-soon"
                type="button"
                on:press={resumable() => match choose_time(None) {
                    Ok(_) => navigate CartPage(),
                    Err(_) => notice = "That could not be chosen just now.",
                }}
            >
                As soon as possible
            </button>
            <!-- Each target stands in a paragraph of its own: a link or a button
                 under 24 pixels tall needs another 24 away (WCAG 2.5.8), and
                 a list of one-line items sets them 18 to 22 apart. -->
            <nav aria-label="Days">
                <ul id="when-days">
                    {#each times.days as d (d.key)}
                        <li><p><a href="/cart/when?day={d.key}">{d.said}</a></p></li>
                    {/each}
                </ul>
            </nav>
            <h2 id="when-day">{times.day}</h2>
            <ul id="when-windows">
                {#each times.windows as w (w.key)}
                    <li>
                        <p><button
                            type="button"
                            aria-label="{w.whole}"
                            on:press={resumable(captures = { w }) => match choose_time(Some(w.start)) {
                                Ok(_) => navigate CartPage(),
                                Err(OrderError.NotOffered(_)) => notice = "That time is no longer offered: choose another.",
                                Err(_) => notice = "That time could not be chosen just now.",
                            }}
                        >
                            {w.said}
                        </button></p>
                    </li>
                {/each}
            </ul>
            <p id="when-notice" role="status">{notice}</p>
            <p><a href="/cart">Back to your cart</a></p>
        </main>
    }
}

// **The stores, as the home page** (ADR-0192): each store by its name and
// what it says of itself, linked to its page, and the session's cart beside
// them. A store list is the first of a delivery site's pages.
user page HomePage() {
    route     "/"
    layout    StoreLayout
    placement origin
    cache     private

    // TRACK SEAM (store-hours): each store with whether it is open.
    let stores = query StoresOpen()
    let cart = query Cart(current_user())

    view {
        <title>Stores</title>
        <meta name="description" content="Order from the stores near you, for delivery or pickup." />
        <main>
            <h1>Stores</h1>
            <!-- TRACK SEAM (store-search): the search box, a plain GET form
                 to the search's route (ADR-0308, amended; ADR-0309). -->
            <form id="home-search" method="get" action="/search" role="search"><label>Stores and dishes <input type="search" name="q" /></label><button>Search</button></form>
            <ul id="stores">
                {#each stores as store (store.id)}
                    <li>
                        <h2><a href="/stores/{store.id}">{store.name}</a></h2>
                        <p class="cuisine">{store.cuisine}</p>
                        <p class="open">{store.said}</p>
                        <p class="rating">{store.rating}</p>
                        <p>{store.description}</p>
                    </li>
                {/each}
            </ul>
            <p aria-live="polite" aria-atomic="true">
                <a id="cart-page" href="/cart">Your cart</a>: <span id="cart-count">{cart.line_count}</span> items
            </p>
        </main>
    }
}
// **The provider's page an order awaits its payment on**, where it awaits
// one (NEXT 6c): what the order page frames.
fn awaited_page(order: Option<OrderStatus>) -> Option<PaymentPage> {
    match order {
        Some(status) => match status {
            OrderStatus.AwaitingPayment(pay) => Some(pay),
            _ => None,
        },
        None => None,
    }
}

// **What an order's total says** (NEXT 6c): to pay, while it awaits its
// payment; nothing, once it was taken back before it was paid (step eight);
// charged, otherwise.
type OrderCharge =
    | ToPay
    | NotCharged
    | Charged

fn charge_of(order: Option<OrderStatus>) -> OrderCharge {
    match order {
        Some(status) => match status {
            OrderStatus.AwaitingPayment(_) => OrderCharge.ToPay,
            OrderStatus.Canceled => OrderCharge.NotCharged,
            _ => OrderCharge.Charged,
        },
        None => OrderCharge.Charged,
    }
}

// **The session's order, as the store moves it along** (ADR-0193): placed,
// being prepared, on its way, delivered. What the store says next reaches the
// page while it is open, and a screen reader says it.
user page OrderPage() {
    route     "/order"
    layout    StoreLayout
    placement origin
    cache     private

    let order = query Order(current_user())
    // TRACK SEAM (order-total): what it was charged.
    let charged = query OrderTotal(current_user())
    // TRACK SEAM (reviews): its stores to rate, once it is delivered.
    let rate = query OrderRatings(current_user())
    // Step eight: why an order was not taken back.
    signal notice: String = ""

    view {
        <title>Your order</title>
        <main>
            <h1>Your order</h1>
            <section aria-label="Status" aria-live="polite" aria-atomic="true">
                {#match order}
                {:Some(status)}
                    {#match status}
                    {:Placed}<p id="order-status">Placed: the store has your order.</p>
                    {:Preparing}<p id="order-status">Preparing: the store is making it.</p>
                    {:OnTheWay}<p id="order-status">On its way to you.</p>
                    {:Delivered}<p id="order-status">Delivered.</p>
                    {:AwaitingPayment(_)}<p id="order-status">Awaiting your payment: pay below, on the provider's page.</p>
                    {:Canceled}<p id="order-status">Canceled: its items are back in your cart.</p>
                    {:Scheduled(_)}<p id="order-status">Scheduled for {when_scheduled(order)}.</p>
                    {/match}
                    <!-- NEXT 6c: to pay, while it awaits its payment, which
                         nothing has charged yet; nothing, taken back before
                         it was paid (step eight); charged, once it is placed. -->
                    {#match charge_of(order)}
                    {:ToPay}{#match charged}{:Some(to_pay)}<p id="order-total">Total to pay: {to_pay.display}</p>{:None}{/match}
                    {:Charged}{#match charged}{:Some(paid)}<p id="order-total">Total charged: {paid.display}</p>{:None}{/match}
                    {:NotCharged}<p id="order-total">Nothing was charged.</p>
                    {/match}
                {:None}<p id="order-status">You have no order yet.</p>
                {/match}
            </section>
            <!-- NEXT 6c: the provider's page, framed outside the status's
                 live region, which a change has read again whole. -->
            {#match awaited_page(order)}
            {:Some(pay)}<section aria-label="Payment">
                <iframe id="payment" src={pay.url} title="Pay for your order"></iframe>
                <!-- Step eight: taken back, its items back in the cart. -->
                {#if SignedIn}<button
                    id="cancel-order"
                    type="button"
                    on:press={resumable() => match cancel_order() {
                        Ok(_) => navigate CartPage(),
                        Err(CancelOrderError.Paid) => notice = "It is paid: the store has your order.",
                        Err(CancelOrderError.PaymentUnavailable) => notice = "Your order could not be canceled just now. Try again in a moment.",
                        Err(CancelOrderError.NotAwaitingPayment) => notice = "There is no order awaiting its payment.",
                    }}
                >
                    Cancel this order
                </button>{/if}
            </section>
            {:None}
            {/match}
            <!-- TRACK SEAM (reviews): once it is delivered, each of its
                 stores to rate, or what the reader gave it (ADR-0341). -->
            {#if rate}<section aria-labelledby="rate-heading">
                <h2 id="rate-heading">Rate your order</h2>
                <ul id="rate-links">
                    {#each rate as link (link.store)}
                        <li>{#if link.open}<a href="/order/rate/{link.store}">{link.said}</a>{:else}{link.said}{/if}</li>
                    {/each}
                </ul>
            </section>{/if}
            <!-- Why an order was not taken back: in the page from the first
                 byte, as a live region is, outside what a server value
                 decides, which the browser does not render again. -->
            <p id="order-notice" role="status">{notice}</p>
            <p><a href="/">Order from a store</a></p>
        </main>
    }
}

// **Where deliveries from a store go** (track `store-accounts`, ADR-0319):
// the reader's saved addresses, each chosen, renamed or removed, and a new
// one saved from the fixed table of places. Choosing or saving one goes back
// to the store, whose page is read after the commit (ADR-0280): its estimate
// is the new address's, as served, with no parameter to bust a cache and no
// second load of the document.
user page AddressPage(id: StoreId) {
    route     "/stores/{id}/address"
    layout    StoreLayout
    placement origin
    cache     private

    let saved = query SavedAddresses(current_user())
    let places = query Places()
    // What the reader calls the address they save or rename.
    signal label: String = ""
    // What the page last had to say.
    signal said: String = ""

    view {
        <title>Delivery address</title>
        <main>
            <h1>Delivery address</h1>
            <label>Call it <input id="label" type="text" bind:value={label} /></label>
            <p id="address-said" role="status">{said}</p>
            <h2>Your addresses</h2>
            <ul id="addresses">
                {#each saved as a (a.id)}
                    <li>
                        <span class="address-label">{a.label}</span>
                        <span class="address-place">{a.place}</span>
                        {#if a.chosen}<span class="address-chosen">Chosen</span>{/if}
                        <button
                            type="button"
                            aria-label="Deliver to {a.label}"
                            on:press={resumable(captures = { a, id }) => match choose_address(a.id) {
                                Ok(_) => navigate StorePage(id),
                                Err(_) => said = "That address could not be chosen.",
                            }}
                        >
                            Deliver here
                        </button>
                        <button
                            type="button"
                            aria-label="Rename {a.label}"
                            on:press={resumable(captures = { a }) => match address_label(label) {
                                Some(called) => match rename_address(a.id, called) {
                                    Ok(_) => said = "Renamed.",
                                    Err(_) => said = "That address could not be renamed.",
                                },
                                None => said = "Type a name of 1 to 40 characters first.",
                            }}
                        >
                            Rename
                        </button>
                        <button
                            type="button"
                            aria-label="Remove {a.label}"
                            on:press={resumable(captures = { a }) => match remove_address(a.id) {
                                Ok(_) => said = "Removed.",
                                Err(_) => said = "That address could not be removed.",
                            }}
                        >
                            Remove
                        </button>
                    </li>
                {/each}
            </ul>
            <h2>Save a new address</h2>
            <ul id="places">
                {#each places as p (p.id)}
                    <li>
                        <span class="place-name">{p.name}</span>
                        <button
                            type="button"
                            aria-label="Save {p.name}"
                            on:press={resumable(captures = { p, id }) => match address_label(label) {
                                Some(called) => match add_address(called, p.id) {
                                    Ok(_) => navigate StorePage(id),
                                    Err(AddressError.TooMany) => said = "You have saved as many addresses as you can.",
                                    Err(_) => said = "That address could not be saved.",
                                },
                                None => said = "Type a name of 1 to 40 characters first.",
                            }}
                        >
                            Save and deliver here
                        </button>
                    </li>
                {/each}
            </ul>
        </main>
    }
}
