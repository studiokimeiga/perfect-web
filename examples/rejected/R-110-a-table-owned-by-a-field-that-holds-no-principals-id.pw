// @corpus: rejected
// @id: R-110
// @category: a table owned by a field that holds no principal's id
// @rule: PW0367
// @invariant: owner_names_a_principal
// @charter: §7.8, §9.2
// @milestone: 14
// @expect-error: `owned by author`: `author` is a `String`, and a principal is named by its id
//
// Track `row-ownership` (ADR-0384's H1): a row's owner is a principal,
// named by the platform's id, so that every read of it takes the
// reader's handle in that field's place. A name is no principal.

module Posts

opaque type PostId = String

type Post = Post { author: String, id: PostId, text: String }

table Posts
    row   Post
    key   author, id
    owned by author
