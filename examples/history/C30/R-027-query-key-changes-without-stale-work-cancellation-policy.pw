// @corpus: rejected
// @id: R-027
// @category: query key changes without stale-work cancellation policy
// @rule: PW0325
// @invariant: stale_key_policy
// @charter: §9.5, §15.6
// @milestone: 4
// @expect-error: `Store` declares no policy for superseded keys
// @expect-error: declare `on_key_change cancel | supersede | keep`
//
// When the key changes, the old request must be cancelled or superseded.
// Leaving it unspecified is how stale responses overwrite fresh ones.

module store.queries

import Stores
import domain.{ StoreId, Store, StoreError }

public query Store(id: StoreId) -> Result<Store, StoreError>
    freshness   30.seconds
    consistency snapshot
    cache       shared
    concurrency one_per_key
    // ERROR: no `on_key_change` policy declared.
{
    Stores.get(id)
}
